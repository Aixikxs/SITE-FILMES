{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site-filmes",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}